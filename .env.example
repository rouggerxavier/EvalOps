APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://evalops:evalops@localhost:5432/evalops
REDIS_URL=redis://localhost:6379/0
# Daily cleanup of expired tokens and exports, run by the worker. The hour is read in
# EVALOPS_MAINTENANCE_TZ (IANA name, UTC by default): 3h UTC is 0h in Brasília (America/Sao_Paulo).
EVALOPS_MAINTENANCE_HOUR=3
EVALOPS_MAINTENANCE_TZ=UTC
EVALOPS_USE_ALEMBIC=0
EVALOPS_EXPORTS_DIR=./apps/api/storage/exports

# Password recovery is disabled until SMTP, fixed public origin and Redis are complete.
# API and worker must receive the same values; never print/reset links as a fallback.
EVALOPS_PUBLIC_ORIGIN=
# Separate opt-in: recovery SMTP configuration alone never enables invitations.
EVALOPS_INVITATIONS_ENABLED=false
EVALOPS_SMTP_HOST=
EVALOPS_SMTP_PORT=587
EVALOPS_SMTP_TLS=starttls
EVALOPS_SMTP_FROM=
EVALOPS_SMTP_USERNAME=
EVALOPS_SMTP_PASSWORD=
EVALOPS_SMTP_TIMEOUT_SECONDS=10

API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
JWT_SECRET=replace-with-at-least-32-bytes-secret

EVALOPS_MAX_BODY_BYTES=8388608
EVALOPS_MAX_SPANS_PER_TRACE=500
# Judge providers: only the ones used by a rubric's model prefix are needed.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

EVALOPS_API_KEY=evk_test_example_replace_me
EVALOPS_API_BASE_URL=http://localhost:8000/v1
EVALOPS_DASHBOARD_BEARER_TOKEN=replace-with-jwt-from-bff
